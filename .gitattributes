# Shell scripts must keep LF endings: they run on Linux (GitHub Actions / WSL2).
# Windows Git defaulting to CRLF would make `#!/usr/bin/env bash` fail with
# "\r: command not found" on every CI run.
*.sh text eol=lf
*.bash text eol=lf

# GitHub Actions workflows are YAML and are parsed on Linux.
*.yml text eol=lf
*.yaml text eol=lf

# Android/Gradle sources: LF keeps Kotlin/XML diffs clean across platforms.
*.kt text eol=lf
*.java text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.pro text eol=lf
